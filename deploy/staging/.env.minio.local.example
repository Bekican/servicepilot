# Local drill credentials only. Never copy them to a real VPS or S3 provider.
MINIO_ROOT_USER=servicepilot-local-backup
MINIO_ROOT_PASSWORD=local-minio-only-password-change-before-sharing
MINIO_BUCKET=servicepilot-offsite-drill
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# HTTP is limited to the local Docker network. Real staging requires S3 over HTTPS.
RESTIC_REPOSITORY=s3:http://minio:9000/servicepilot-offsite-drill/restic
RESTIC_PASSWORD=local-restic-only-password-with-at-least-32-characters
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
