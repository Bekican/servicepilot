# Copy to /etc/servicepilot/staging.env, replace every placeholder, assign it
# to the restricted servicepilot operator, then chmod 600.
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=operations@example.com

POSTGRES_DB=servicepilot_staging
POSTGRES_USER=servicepilot_staging
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Staging email is deliberately captured by private Mailpit and never delivered.
SMTP_FROM_ADDRESS=no-reply@staging.example.com
SMTP_FROM_NAME=ServicePilot Staging

# Application references must be immutable registry digests.
SERVICEPILOT_API_IMAGE=ghcr.io/example/servicepilot-api@sha256:replace-with-64-hex-characters
SERVICEPILOT_WEB_IMAGE=ghcr.io/example/servicepilot-web@sha256:replace-with-64-hex-characters
SERVICEPILOT_WORKER_IMAGE=ghcr.io/example/servicepilot-worker@sha256:replace-with-64-hex-characters
SERVICEPILOT_MIGRATOR_IMAGE=ghcr.io/example/servicepilot-migrator@sha256:replace-with-64-hex-characters
SERVICEPILOT_BACKUP_IMAGE=ghcr.io/example/servicepilot-backup@sha256:replace-with-64-hex-characters

# Restic encrypts locally before sending data to an S3-compatible provider.
RESTIC_REPOSITORY=s3:https://s3.example.com/servicepilot-staging
RESTIC_PASSWORD=replace-with-a-separately-stored-long-random-restic-password
AWS_ACCESS_KEY_ID=replace-with-a-dedicated-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-dedicated-backup-secret-key
AWS_DEFAULT_REGION=auto
RESTIC_AUTO_INIT=false
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_APPLY_RETENTION=true

# Optional. The URL is called only after every backup stage succeeds.
BACKUP_HEARTBEAT_URL=
