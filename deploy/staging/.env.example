# Copy to /etc/servicepilot/staging.env, replace every placeholder, assign it
# to the restricted servicepilot operator, then chmod 600.
DEPLOYMENT_TIER=staging
COMPOSE_PROJECT_NAME=servicepilot-staging
OFFSITE_BACKUP_ENABLED=false
OBSERVABILITY_ENABLED=false
SMTP_MODE=mailpit

PUBLIC_DOMAIN=staging.example.com
ACME_EMAIL=operations@example.com
DOTNET_ENVIRONMENT_NAME=Staging
MAILPIT_UI_PORT=8025

POSTGRES_DB=servicepilot_staging
POSTGRES_USER=servicepilot_staging
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Runtime infrastructure images must also be resolved to immutable digests.
POSTGRES_IMAGE=postgres:17-alpine@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MAILPIT_IMAGE=axllent/mailpit:v1.27@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
CADDY_IMAGE=caddy:2-alpine@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# Staging captures mail in private Mailpit. For production select external and
# provide the real provider values without committing them.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_FROM_ADDRESS=no-reply@staging.example.com
SMTP_FROM_NAME=ServicePilot Staging
SMTP_USERNAME=
SMTP_PASSWORD=

# Required only when OBSERVABILITY_ENABLED=true.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector:0.157.0@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
OTEL_BACKEND_ENDPOINT=
OTEL_BACKEND_AUTHORIZATION=

# Required only when OFFSITE_BACKUP_ENABLED=true. Restic encrypts locally
# before sending data to the HTTPS S3-compatible provider.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
RESTIC_AUTO_INIT=false
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_APPLY_RETENTION=true
BACKUP_HEARTBEAT_URL=
