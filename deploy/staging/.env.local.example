STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443

SERVICEPILOT_API_IMAGE=servicepilot-staging-api:local
SERVICEPILOT_WEB_IMAGE=servicepilot-staging-web:local
SERVICEPILOT_WORKER_IMAGE=servicepilot-staging-worker:local
