{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "ServicePilot",
    "Audience": "ServicePilot.Api",
    "AccessTokenLifetimeMinutes": 60
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 60,
    "InvitationPermitLimit": 30,
    "PasswordResetPermitLimit": 3,
    "PasswordResetWindowMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "AllowedHosts": "*"
}
