{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "ServicePilot",
    "Audience": "ServicePilot.Api",
    "AccessTokenLifetimeMinutes": 60
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 60,
    "InvitationPermitLimit": 30,
    "PasswordResetPermitLimit": 3,
    "PasswordResetWindowMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "KnowledgeStorage": {
    "RootPath": "data"
  },
  "KnowledgeAi": {
    "OllamaBaseUrl": "http://localhost:11434",
    "ChatModel": "qwen3:4b",
    "EmbeddingModel": "qwen3-embedding:0.6b",
    "EmbeddingDimensions": 1024,
    "EmbeddingBatchSize": 16
  },
  "AllowedHosts": "*"
}
